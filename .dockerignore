# Ignore node modules and local build outputs
**/node_modules
**/dist
**/dist-ssr

# Ignore python caches and virtual environments
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
**/.venv
**/venv
**/env
**/ENV
**/.cache

# Ignore git and local environment files
**/.git
**/.gitignore
**/.env*

# Ignore IDE and OS files
**/.vscode
**/.idea
**/.DS_Store
**/Thumbs.db

# Ignore local run scripts and temporary files
**/run.bat
**/*.log
**/*.sqlite
**/user_portfolio.xlsx
